# Overturn — environment variables. Copy to .env.local (web app) and mcp/.env (MCP server).
# Never commit .env.local or mcp/.env. Every value below is read server-side only.

# ───────────── Language model (feature 001 + 002) ─────────────
# Provider selector: anthropic (default) | nebius | fake
OVERTURN_LLM_PROVIDER=anthropic

# `fake` answers from the golden samples in data/samples: no API call, no key, deterministic.
# It is what `pnpm test` and the MCP conformance test run on. Never a production fallback.
OVERTURN_FAKE_SAMPLE=02-prior-auth-ca

# Anthropic (default provider)
ANTHROPIC_API_KEY=
OVERTURN_MODEL=claude-opus-5
OVERTURN_EXTRACT_EFFORT=medium
OVERTURN_WRITE_EFFORT=medium

# Nebius Token Factory (second provider; OpenAI-compatible). Nemotron 3 is text-only:
# PDFs are read as text, images need NEBIUS_VISION_MODEL or are refused.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_EXTRACT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_WRITE=nvidia/nemotron-3-super-120b-a12b
NEBIUS_VISION_MODEL=

# Web app switches (feature 001)
OVERTURN_LIVE_UPLOADS=true
OVERTURN_RATE_LIMIT=

# ───────────── MCP server (mcp/, feature 002) ─────────────
MCP_PORT=8000
MCP_PATH=/mcp
# Public origin of the MCP server, used in WWW-Authenticate / protected-resource metadata
MCP_PUBLIC_URL=http://localhost:8000
# Auth mode: oidc (default) | dev  (dev = accept MCP_DEV_BEARER only; still 401 without it).
# The server refuses to start if neither is configured: it fails closed, never open.
MCP_AUTH_MODE=dev
MCP_DEV_BEARER=
# Email used as the linked account in dev mode (never a real person)
MCP_DEV_EMAIL=dev@example.com
# Case lifetime (minutes of inactivity) and code tombstone (hours). An MCP session lives twice
# the case lifetime, so a person returning just after expiry is told why, not given an error.
MCP_CASE_TTL_MINUTES=30
MCP_CODE_TOMBSTONE_HOURS=24

# Browser origins allowed to call /mcp, besides MCP_PUBLIC_URL's own (MCP 2025-11-25 requires
# Origin validation). Requests with no Origin — server-side clients — are allowed and still need
# their bearer. Add the MCP Inspector's origin for local testing, e.g. http://localhost:6274
MCP_ALLOWED_ORIGINS=
# Bounds for a public endpoint: request body (bytes; leaves room for a PDF in base64), open
# sessions per account, and open sessions for the whole process.
MCP_MAX_BODY_BYTES=10485760
MCP_MAX_SESSIONS_PER_SUBJECT=5
MCP_MAX_SESSIONS=500

# ───────────── OAuth 2.1 authorization server (authorization code + PKCE) ─────────────
# Any OIDC provider that issues JWT access tokens. Auth0 during the hackathon, because it supports
# dynamic client registration; the server checks the token, not the vendor.
# Issuer exactly as the tokens carry it — Auth0's ends in a slash, and the check is an equality.
OIDC_ISSUER=
# The API identifier this server is registered under; checked against the token's `aud`.
OIDC_AUDIENCE=
# Optional comma-separated allow-list of calling applications, checked against `azp`
# (or Cognito's `client_id`). OIDC_AUDIENCE or OIDC_CLIENT_IDS is required — one of the two must
# bind the token to this resource.
OIDC_CLIENT_IDS=
# Derived from the issuer unless set explicitly.
OIDC_JWKS_URL=
OIDC_USERINFO_URL=
# Client ID used by the simulator for its own PKCE flow (public client, no secret)
OIDC_CLIENT_ID=

# Pins the server clock to an instant and mounts POST /__test/clock. Conformance test only;
# never set in production. Example: 2026-10-21T10:00:00Z
OVERTURN_CLOCK=

# ───────────── Simulator web app (/sim, /companion) ─────────────
# Where the simulator's MCP client connects (local server or AgentCore invocation URL)
OVERTURN_MCP_URL=http://localhost:8000/mcp
# Public base URL of the web app, used for the OAuth callback and companion links/QR
SIM_BASE_URL=http://localhost:3000
# Secret used to sign the simulator session cookie (random 32+ bytes; tokens are never in the cookie)
SIM_SESSION_SECRET=

# ───────────── AWS (SES email, Polly speech, AgentCore) ─────────────
AWS_REGION=us-east-1
# Local dev only; on AgentCore/Vercel prefer an IAM role or project env vars
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES: verified sender identity. In the SES sandbox the recipient must be verified too.
SES_FROM=
SES_CONFIGURATION_SET=
# Polly: neural voice for the simulated assistant; empty = browser speechSynthesis only
POLLY_VOICE=Danielle
# AgentCore (deployment scripts only)
AGENTCORE_RUNTIME_ARN=
ECR_REPOSITORY=

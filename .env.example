# Overturn — environment variables. Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
# Only ANTHROPIC_API_KEY is required, and only for live uploads: the seven sample documents work
# without any key at all. Never commit .env.local — .gitignore keeps it out.

# ───────────── Language model ─────────────
# Which provider runs extraction, explanation and drafting:
#   anthropic (default) — Claude, through the Anthropic API
#   fake                — answers from the golden samples in data/samples; no key, no network.
#                         What `pnpm test` runs on. Never a production fallback.
#   nebius              — declared, not implemented yet
OVERTURN_LLM_PROVIDER=anthropic

# Anthropic. Server-only: the key never reaches the browser.
ANTHROPIC_API_KEY=
OVERTURN_MODEL=claude-opus-5
# low | medium | high — tune cost without a deploy
OVERTURN_EXTRACT_EFFORT=medium
OVERTURN_WRITE_EFFORT=medium

# Sample answered by the fake provider's extraction step (a file stem in data/samples).
OVERTURN_FAKE_SAMPLE=02-prior-auth-ca

# ───────────── Web app ─────────────
# Set to false to pause live uploads (e.g. if API credits run out); the samples keep working.
OVERTURN_LIVE_UPLOADS=true
# Live model calls allowed per visitor per 15 minutes (default 3).
OVERTURN_RATE_LIMIT=3
# Public origin, used for absolute URLs in Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────── Tests ─────────────
# Point Playwright at a running deployment instead of starting a local server.
E2E_BASE_URL=
